rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable hardened primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll([
        'uid',
        'displayName',
        'puzzleId',
        'steps',
        'parSteps',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid',
        'displayName',
        'puzzleId',
        'steps',
        'parSteps',
        'createdAt',
        'updatedAt'
      ]) &&
      data.uid is string &&
      data.uid.size() >= 1 &&
      data.uid.size() <= 128 &&
      data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.uid == request.auth.uid &&
      data.displayName is string &&
      data.displayName.size() >= 1 &&
      data.displayName.size() <= 60 &&
      data.puzzleId is int &&
      data.puzzleId >= 1 &&
      data.puzzleId <= 1000 &&
      data.steps is int &&
      data.steps >= 1 &&
      data.steps <= 500 &&
      data.parSteps is int &&
      data.parSteps >= 1 &&
      data.parSteps <= 500 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    match /leaderboardEntries/{entryId} {
      // Non-PII public leaderboard scores
      allow get: if isValidId(entryId);
      allow list: if resource.data.puzzleId >= 1 &&
        resource.data.puzzleId <= 1000;

      allow create: if isVerifiedUser() &&
        isValidId(entryId) &&
        isValidLeaderboardEntry(incoming()) &&
        entryId == (string(incoming().puzzleId) + '_' + request.auth.uid) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(entryId) &&
        isValidLeaderboardEntry(incoming()) &&
        existing().uid == request.auth.uid &&
        incoming().uid == existing().uid &&
        incoming().puzzleId == existing().puzzleId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().steps <= existing().steps &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'steps',
          'parSteps',
          'updatedAt'
        ]);

      allow delete: if isVerifiedUser() &&
        isValidId(entryId) &&
        existing().uid == request.auth.uid;
    }
  }
}
